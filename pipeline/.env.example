DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE

# Your Google email: your Discord alerts fall back to DISCORD_WEBHOOK_URL, and migrate-owner uses it
OWNER_EMAIL=you@gmail.com
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook

# Optional: most AI scores per run across all users (default 400)
MAX_SCORES_PER_RUN=400
