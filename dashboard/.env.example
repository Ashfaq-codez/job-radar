# Copy to .env.local and fill in. Never commit .env.local.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Better Auth: a random 32+ character secret (run: openssl rand -base64 32) and this app's URL
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Your Google email: always allowed to sign in, and the only admin
OWNER_EMAIL=you@gmail.com

# Resume suggestions during onboarding (same key as the pipeline)
OPENAI_API_KEY=

# Optional: lets the owner's "Send test alert" use the pipeline's webhook
DISCORD_WEBHOOK_URL=
